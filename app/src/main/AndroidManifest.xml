<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Needed to list and start other apps for the "open app" action (package visibility, Android 11+). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application
      android:allowBackup="true"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:theme="@style/Theme.Settings">

    <activity
        android:name=".MainActivity"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Started by Motorola's key service (com.motorola.mykey) for each AI key press. -->
    <activity
        android:name=".TriggerActivity"
        android:excludeFromRecents="true"
        android:exported="true"
        android:noHistory="true"
        android:taskAffinity=""
        android:theme="@style/Theme.Trigger" />
  </application>
</manifest>
